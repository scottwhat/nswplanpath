# Mapbox public token (pk.…), URL-restricted in the Mapbox dashboard
VITE_MAPBOX_ACCESS_TOKEN=

# Chat backend — the `PlanPathChatStack` outputs in infra/. All three must be
# set together, or all left blank to run the local stub. The browser signs
# POST /chat with Cognito unauthenticated creds and gets back short-lived
# credentials plus the harness ARN, then streams InvokeHarness directly.
#
# The harness ARN is deliberately NOT here: it is chosen by the broker, and the
# credentials it mints are IAM-scoped to that one harness. Change the harness in
# infra/bin/infra.ts and redeploy, not here.
#
#   ChatApiUrl        -> VITE_CHAT_API_URL
#   ChatIdentityPoolId -> VITE_CHAT_IDENTITY_POOL_ID
VITE_CHAT_API_URL=
VITE_CHAT_IDENTITY_POOL_ID=

# Region of the chat API (not the harness — that lives in us-east-1 and is
# returned by the broker as `harnessRegion`).
VITE_AWS_REGION=ap-southeast-2
